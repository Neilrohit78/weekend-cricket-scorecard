<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<title>Weekend Cricket Scorecard</title>
<style>
  :root {
    --bg: #0f172a; --card: #1e293b; --accent: #22c55e; --danger: #ef4444;
    --text: #f1f5f9; --muted: #94a3b8; --border: #334155;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: system-ui, -apple-system, sans-serif;
    background: var(--bg); color: var(--text);
    min-height: 100vh; padding: 12px; line-height: 1.4;
  }
  h1, h2, h3 { font-weight: 600; }
  .container { max-width: 480px; margin: 0 auto; }
  .card {
    background: var(--card); border-radius: 12px; padding: 16px;
    margin-bottom: 12px; border: 1px solid var(--border);
  }
  .score-hero {
    text-align: center; padding: 20px 12px;
    background: linear-gradient(135deg, #1e293b, #0f172a);
  }
  .score-hero .teams { font-size: 0.95rem; color: var(--muted); margin-bottom: 4px; }
  .score-hero .main-score { font-size: 2.8rem; font-weight: 700; letter-spacing: -1px; }
  .score-hero .overs { font-size: 1.1rem; color: var(--muted); }
  .score-hero .rr { font-size: 0.9rem; margin-top: 6px; }
  .batsmen, .bowler { display: flex; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
  .player { flex: 1; min-width: 140px; }
  .player .name { font-weight: 600; }
  .player .stats { font-size: 0.85rem; color: var(--muted); }
  .striker { color: var(--accent); }
  .controls { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .btn {
    background: #334155; border: none; color: white; padding: 14px 8px;
    border-radius: 8px; font-size: 1rem; font-weight: 600; cursor: pointer;
    touch-action: manipulation;
  }
  .btn:active { transform: scale(0.96); }
  .btn.run { background: #22c55e; color: #0f172a; }
  .btn.boundary { background: #eab308; color: #0f172a; }
  .btn.wicket { background: var(--danger); }
  .btn.extra { background: #6366f1; }
  .btn.secondary { background: #475569; font-size: 0.85rem; padding: 10px; }
  .btn:disabled { opacity: 0.4; cursor: not-allowed; }
  input, select {
    width: 100%; padding: 10px; border-radius: 8px; border: 1px solid var(--border);
    background: #0f172a; color: var(--text); margin-bottom: 8px; font-size: 1rem;
  }
  label { font-size: 0.85rem; color: var(--muted); display: block; margin-bottom: 4px; }
  .setup-grid { display: grid; gap: 10px; }
  .history { max-height: 120px; overflow-y: auto; font-size: 0.8rem; color: var(--muted); }
  .badge { display: inline-block; background: #334155; padding: 2px 8px; border-radius: 999px; font-size: 0.75rem; }
  .result { text-align: center; font-size: 1.2rem; color: var(--accent); padding: 12px; }
  .tabs { display: flex; gap: 4px; margin-bottom: 12px; }
  .tab { flex: 1; padding: 8px; text-align: center; background: #334155; border-radius: 8px; cursor: pointer; font-size: 0.9rem; }
  .tab.active { background: var(--accent); color: #0f172a; }
  .hidden { display: none !important; }
  .row { display: flex; gap: 8px; align-items: center; }
  .row > * { flex: 1; }
</style>
</head>
<body>
<div class="container">
  <!-- SETUP SCREEN -->
  <div id="setup" class="card">
    <h2 style="margin-bottom:12px">🏏 Weekend Cricket Scorecard</h2>
    <div class="setup-grid">
      <div>
        <label>Team A Name</label>
        <input id="teamA" value="Team A" placeholder="Home team">
      </div>
      <div>
        <label>Team B Name</label>
        <input id="teamB" value="Team B" placeholder="Away team">
      </div>
      <div class="row">
        <div>
          <label>Overs</label>
          <input id="maxOvers" type="number" value="20" min="1" max="50">
        </div>
        <div>
          <label>Players/side</label>
          <input id="playersPerSide" type="number" value="11" min="2" max="15">
        </div>
      </div>
      <div>
        <label>Who bats first?</label>
        <select id="batsFirst">
          <option value="A">Team A</option>
          <option value="B">Team B</option>
        </select>
      </div>
      <button class="btn run" onclick="startMatch()">Start Match</button>
      <button class="btn secondary" onclick="loadMatch()">Load Saved Match</button>
    </div>
  </div>

  <!-- LIVE SCOREBOARD -->
  <div id="live" class="hidden">
    <div class="card score-hero">
      <div class="teams" id="matchTitle">Team A vs Team B</div>
      <div class="main-score" id="mainScore">0/0</div>
      <div class="overs" id="oversDisplay">0.0 / 20</div>
      <div class="rr" id="rrDisplay">CRR: 0.00</div>
      <div id="targetInfo" class="rr"></div>
    </div>

    <div class="card">
      <div class="batsmen">
        <div class="player">
          <div class="name striker" id="strikerName">Striker *</div>
          <div class="stats" id="strikerStats">0 (0) • SR 0</div>
        </div>
        <div class="player">
          <div class="name" id="nonStrikerName">Non-striker</div>
          <div class="stats" id="nonStrikerStats">0 (0)</div>
        </div>
      </div>
      <div style="margin-top:10px" class="bowler">
        <div class="player">
          <div class="name" id="bowlerName">Bowler</div>
          <div class="stats" id="bowlerStats">0-0-0-0</div>
        </div>
        <div class="player" style="text-align:right">
          <div class="name">Partnership</div>
          <div class="stats" id="partnership">0 (0)</div>
        </div>
      </div>
    </div>

    <!-- SCORING CONTROLS -->
    <div class="card">
      <div class="controls" id="scoreControls">
        <button class="btn" onclick="score(0)">•</button>
        <button class="btn run" onclick="score(1)">1</button>
        <button class="btn run" onclick="score(2)">2</button>
        <button class="btn run" onclick="score(3)">3</button>
        <button class="btn boundary" onclick="score(4)">4</button>
        <button class="btn boundary" onclick="score(6)">6</button>
        <button class="btn wicket" onclick="scoreWicket()">W</button>
        <button class="btn extra" onclick="scoreExtra('wide')">Wd</button>
        <button class="btn extra" onclick="scoreExtra('noball')">Nb</button>
        <button class="btn extra" onclick="scoreExtra('bye')">Bye</button>
        <button class="btn extra" onclick="scoreExtra('legbye')">Lb</button>
        <button class="btn secondary" onclick="undo()">Undo</button>
      </div>
      <div style="margin-top:10px; display:flex; gap:8px; flex-wrap:wrap">
        <button class="btn secondary" onclick="changeBowler()">Change Bowler</button>
        <button class="btn secondary" onclick="rotateStrike()">Rotate Strike</button>
        <button class="btn secondary" onclick="endInnings()">End Innings</button>
        <button class="btn secondary" onclick="saveMatch()">Save</button>
        <button class="btn secondary" onclick="showScorecard()">Full Card</button>
      </div>
    </div>

    <div class="card">
      <div class="tabs">
        <div class="tab active" onclick="showTab('thisOver')">This Over</div>
        <div class="tab" onclick="showTab('fow')">Fall of Wkt</div>
        <div class="tab" onclick="showTab('extras')">Extras</div>
      </div>
      <div id="thisOver" class="history"></div>
      <div id="fow" class="history hidden"></div>
      <div id="extras" class="history hidden"></div>
    </div>

    <div id="resultBox" class="card result hidden"></div>
  </div>

  <!-- FULL SCORECARD MODAL (simple) -->
  <div id="scorecardModal" class="card hidden" style="position:fixed;inset:12px;z-index:100;overflow:auto;max-height:90vh">
    <h3>Full Scorecard <button class="btn secondary" style="float:right;padding:4px 10px" onclick="hideScorecard()">Close</button></h3>
    <div id="fullScorecard" style="margin-top:12px;font-size:0.9rem"></div>
  </div>
</div>

<script>
// ===================== STATE =====================
let state = {
  teamA: 'Team A', teamB: 'Team B',
  maxOvers: 20, playersPerSide: 11,
  battingFirst: 'A',
  innings: 1, // 1 or 2
  battingTeam: 'A',
  score: 0, wickets: 0, balls: 0, // total legal balls
  extras: { wide:0, noball:0, bye:0, legbye:0, total:0 },
  target: null,
  striker: { name:'Batter 1', runs:0, balls:0, fours:0, sixes:0 },
  nonStriker: { name:'Batter 2', runs:0, balls:0, fours:0, sixes:0 },
  bowler: { name:'Bowler 1', overs:0, balls:0, runs:0, wickets:0, maidens:0 },
  partnership: { runs:0, balls:0 },
  thisOver: [],
  fallOfWickets: [],
  history: [], // for undo
  innings1Score: null,
  finished: false,
  result: ''
};

// ===================== HELPERS =====================
function ballsToOvers(b) {
  return Math.floor(b/6) + '.' + (b%6);
}
function crr() {
  if (state.balls === 0) return '0.00';
  return ((state.score / state.balls) * 6).toFixed(2);
}
function rrr() {
  if (!state.target || state.innings !== 2) return null;
  const remainingBalls = state.maxOvers*6 - state.balls;
  if (remainingBalls <= 0) return '0.00';
  const needed = state.target - state.score;
  return ((needed / remainingBalls) * 6).toFixed(2);
}
function saveHistory() {
  state.history.push(JSON.parse(JSON.stringify({
    score: state.score, wickets: state.wickets, balls: state.balls,
    extras: {...state.extras},
    striker: {...state.striker}, nonStriker: {...state.nonStriker},
    bowler: {...state.bowler}, partnership: {...state.partnership},
    thisOver: [...state.thisOver], fallOfWickets: [...state.fallOfWickets]
  })));
  if (state.history.length > 30) state.history.shift();
}

// ===================== CORE SCORING =====================
function score(runs) {
  if (state.finished) return;
  saveHistory();
  state.score += runs;
  state.striker.runs += runs;
  state.striker.balls += 1;
  if (runs === 4) state.striker.fours += 1;
  if (runs === 6) state.striker.sixes += 1;
  state.partnership.runs += runs;
  state.partnership.balls += 1;
  state.bowler.runs += runs;
  state.thisOver.push(runs === 0 ? '•' : String(runs));
  advanceBall(runs % 2 === 1); // rotate on odd
  updateUI();
  checkEnd();
}

function scoreWicket() {
  if (state.finished || state.wickets >= state.playersPerSide - 1) return;
  saveHistory();
  state.wickets += 1;
  state.striker.balls += 1;
  state.partnership.balls += 1;
  state.bowler.wickets += 1;
  state.bowler.balls += 1; // legal ball
  state.thisOver.push('W');
  state.fallOfWickets.push(`${state.score}/${state.wickets} (${ballsToOvers(state.balls+1)}) ${state.striker.name}`);
  // New batter
  const newName = prompt('New batter name:', `Batter ${state.wickets + 2}`) || `Batter ${state.wickets + 2}`;
  state.striker = { name: newName, runs:0, balls:0, fours:0, sixes:0 };
  state.partnership = { runs:0, balls:0 };
  advanceBall(false);
  updateUI();
  checkEnd();
}

function scoreExtra(type) {
  if (state.finished) return;
  saveHistory();
  let runs = 1; // default wide/nb
  if (type === 'bye' || type === 'legbye') {
    runs = parseInt(prompt('Runs (bye/leg-bye):', '1') || '1', 10);
    state.score += runs;
    state.extras[type] += runs;
    state.extras.total += runs;
    state.striker.balls += 1; // legal
    state.partnership.runs += runs;
    state.partnership.balls += 1;
    state.bowler.runs += runs; // byes/lb count against bowler in most casual scoring
    state.thisOver.push(type === 'bye' ? `b${runs}` : `lb${runs}`);
    advanceBall(runs % 2 === 1);
  } else {
    // wide or noball
    const extraRuns = parseInt(prompt(`Extra runs on ${type} (0 if none):`, '0') || '0', 10);
    state.score += 1 + extraRuns;
    state.extras[type] += 1 + extraRuns;
    state.extras.total += 1 + extraRuns;
    state.bowler.runs += 1 + extraRuns;
    state.thisOver.push(type === 'wide' ? `Wd+${extraRuns}` : `Nb+${extraRuns}`);
    // no advance of legal balls
    if (extraRuns % 2 === 1) rotateStrikeInternal();
  }
  updateUI();
  checkEnd();
}

function advanceBall(rotate) {
  state.balls += 1;
  state.bowler.balls += 1;
  if (state.bowler.balls === 6) {
    // end of over
    if (state.bowler.runs === 0 && state.thisOver.every(x => x === '•' || x === 'W')) {
      // simplified maiden check
      state.bowler.maidens += 1;
    }
    state.bowler.overs += 1;
    state.bowler.balls = 0;
    state.thisOver = [];
    rotateStrikeInternal(); // always rotate at end of over
    setTimeout(() => {
      const next = prompt('Next bowler name:', state.bowler.name === 'Bowler 1' ? 'Bowler 2' : 'Bowler 1');
      if (next) {
        state.bowler = { name: next, overs:0, balls:0, runs:0, wickets:0, maidens:0 };
      }
      updateUI();
    }, 100);
  } else if (rotate) {
    rotateStrikeInternal();
  }
}

function rotateStrikeInternal() {
  const t = state.striker;
  state.striker = state.nonStriker;
  state.nonStriker = t;
}

function rotateStrike() {
  rotateStrikeInternal();
  updateUI();
}

function changeBowler() {
  const name = prompt('New bowler:', state.bowler.name);
  if (name) {
    state.bowler = { name, overs:0, balls:0, runs:0, wickets:0, maidens:0 };
    updateUI();
  }
}

function undo() {
  if (state.history.length === 0) return;
  const prev = state.history.pop();
  Object.assign(state, prev);
  updateUI();
}

function checkEnd() {
  const maxBalls = state.maxOvers * 6;
  const allOut = state.wickets >= state.playersPerSide - 1;
  if (allOut || state.balls >= maxBalls) {
    endInnings(true);
  }
  if (state.innings === 2 && state.target && state.score >= state.target) {
    state.finished = true;
    state.result = `${state.battingTeam === 'A' ? state.teamA : state.teamB} won by ${state.playersPerSide - 1 - state.wickets} wickets`;
    updateUI();
  }
}

function endInnings(auto = false) {
  if (state.innings === 1) {
    state.innings1Score = { score: state.score, wickets: state.wickets, overs: ballsToOvers(state.balls) };
    state.target = state.score + 1;
    state.innings = 2;
    state.battingTeam = state.battingTeam === 'A' ? 'B' : 'A';
    // reset for new innings
    state.score = 0; state.wickets = 0; state.balls = 0;
    state.extras = { wide:0, noball:0, bye:0, legbye:0, total:0 };
    state.striker = { name: 'Batter 1', runs:0, balls:0, fours:0, sixes:0 };
    state.nonStriker = { name: 'Batter 2', runs:0, balls:0, fours:0, sixes:0 };
    state.bowler = { name: 'Bowler 1', overs:0, balls:0, runs:0, wickets:0, maidens:0 };
    state.partnership = { runs:0, balls:0 };
    state.thisOver = []; state.fallOfWickets = [];
    if (!auto) alert('Innings ended. Second innings starting. Target: ' + state.target);
  } else {
    state.finished = true;
    const chasing = state.battingTeam === 'A' ? state.teamA : state.teamB;
    if (state.score >= state.target) {
      state.result = `${chasing} won by ${state.playersPerSide - 1 - state.wickets} wickets`;
    } else {
      const margin = state.target - 1 - state.score;
      state.result = `${state.battingTeam === 'A' ? state.teamB : state.teamA} won by ${margin} runs`;
    }
  }
  updateUI();
}

// ===================== UI =====================
function updateUI() {
  const battingName = state.battingTeam === 'A' ? state.teamA : state.teamB;
  const bowlingName = state.battingTeam === 'A' ? state.teamB : state.teamA;
  document.getElementById('matchTitle').textContent = `${state.teamA} vs ${state.teamB} • Inn ${state.innings}`;
  document.getElementById('mainScore').textContent = `${state.score}/${state.wickets}`;
  document.getElementById('oversDisplay').textContent = `${ballsToOvers(state.balls)} / ${state.maxOvers}`;
  let rrText = `CRR: ${crr()}`;
  const r = rrr();
  if (r !== null) rrText += ` | RRR: ${r}`;
  document.getElementById('rrDisplay').textContent = rrText;
  document.getElementById('targetInfo').textContent = state.target ? `Target: ${state.target}` : '';

  document.getElementById('strikerName').textContent = state.striker.name + ' *';
  document.getElementById('strikerStats').textContent = `${state.striker.runs} (${state.striker.balls}) • 4s:${state.striker.fours} 6s:${state.striker.sixes} SR:${state.striker.balls ? ((state.striker.runs/state.striker.balls)*100).toFixed(0) : 0}`;
  document.getElementById('nonStrikerName').textContent = state.nonStriker.name;
  document.getElementById('nonStrikerStats').textContent = `${state.nonStriker.runs} (${state.nonStriker.balls})`;
  document.getElementById('bowlerName').textContent = state.bowler.name;
  const bOvers = state.bowler.overs + (state.bowler.balls/10);
  document.getElementById('bowlerStats').textContent = `${state.bowler.overs}.${state.bowler.balls}-${state.bowler.maidens}-${state.bowler.runs}-${state.bowler.wickets}`;
  document.getElementById('partnership').textContent = `${state.partnership.runs} (${state.partnership.balls})`;

  document.getElementById('thisOver').textContent = state.thisOver.length ? state.thisOver.join('  ') : '—';
  document.getElementById('fow').innerHTML = state.fallOfWickets.length ? state.fallOfWickets.map(f => `<div>${f}</div>`).join('') : '—';
  document.getElementById('extras').textContent = `Wd ${state.extras.wide}  Nb ${state.extras.noball}  B ${state.extras.bye}  Lb ${state.extras.legbye}  Total ${state.extras.total}`;

  if (state.finished) {
    document.getElementById('resultBox').classList.remove('hidden');
    document.getElementById('resultBox').textContent = state.result;
    document.querySelectorAll('#scoreControls button').forEach(b => b.disabled = true);
  } else {
    document.getElementById('resultBox').classList.add('hidden');
  }
}

function showTab(id) {
  ['thisOver','fow','extras'].forEach(t => {
    document.getElementById(t).classList.toggle('hidden', t !== id);
  });
  document.querySelectorAll('.tab').forEach(tab => tab.classList.remove('active'));
  event.target.classList.add('active');
}

function startMatch() {
  state.teamA = document.getElementById('teamA').value || 'Team A';
  state.teamB = document.getElementById('teamB').value || 'Team B';
  state.maxOvers = parseInt(document.getElementById('maxOvers').value) || 20;
  state.playersPerSide = parseInt(document.getElementById('playersPerSide').value) || 11;
  state.battingFirst = document.getElementById('batsFirst').value;
  state.battingTeam = state.battingFirst;
  // reset everything else
  state.innings = 1; state.score = 0; state.wickets = 0; state.balls = 0;
  state.extras = { wide:0, noball:0, bye:0, legbye:0, total:0 };
  state.target = null; state.finished = false; state.result = '';
  state.striker = { name: 'Batter 1', runs:0, balls:0, fours:0, sixes:0 };
  state.nonStriker = { name: 'Batter 2', runs:0, balls:0, fours:0, sixes:0 };
  state.bowler = { name: 'Bowler 1', overs:0, balls:0, runs:0, wickets:0, maidens:0 };
  state.partnership = { runs:0, balls:0 };
  state.thisOver = []; state.fallOfWickets = []; state.history = [];
  document.getElementById('setup').classList.add('hidden');
  document.getElementById('live').classList.remove('hidden');
  updateUI();
}

function saveMatch() {
  localStorage.setItem('weekendCricket', JSON.stringify(state));
  alert('Match saved! You can close the tab and Load later.');
}
function loadMatch() {
  const raw = localStorage.getItem('weekendCricket');
  if (!raw) { alert('No saved match'); return; }
  state = JSON.parse(raw);
  document.getElementById('setup').classList.add('hidden');
  document.getElementById('live').classList.remove('hidden');
  updateUI();
}

function showScorecard() {
  let html = `<strong>${state.teamA} vs ${state.teamB}</strong><br>`;
  if (state.innings1Score) {
    html += `1st Innings: ${state.innings1Score.score}/${state.innings1Score.wickets} (${state.innings1Score.overs})<br>`;
  }
  html += `Current: ${state.score}/${state.wickets} (${ballsToOvers(state.balls)})<br><br>`;
  html += `<strong>Batting</strong><br>${state.striker.name}: ${state.striker.runs} (${state.striker.balls})<br>`;
  html += `${state.nonStriker.name}: ${state.nonStriker.runs} (${state.nonStriker.balls})<br>`;
  html += `Extras: ${state.extras.total}<br><br>`;
  html += `<strong>Fall of Wickets</strong><br>${state.fallOfWickets.join('<br>') || '—'}`;
  document.getElementById('fullScorecard').innerHTML = html;
  document.getElementById('scorecardModal').classList.remove('hidden');
}
function hideScorecard() {
  document.getElementById('scorecardModal').classList.add('hidden');
}

// Init
updateUI();
</script>
</body>
</html>
